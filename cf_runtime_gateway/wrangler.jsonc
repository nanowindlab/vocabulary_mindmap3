{
  "$schema": "../09_app/node_modules/wrangler/config-schema.json",
  "name": "mm3-runtime-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-03-30",
  "secrets": {
    "required": ["MM3_RUNTIME_GATEWAY_TOKEN"]
  },
  "r2_buckets": [
    {
      "binding": "MM3_BUCKET",
      "bucket_name": "vocabulary-mindmap3-runtime"
    }
  ]
}
